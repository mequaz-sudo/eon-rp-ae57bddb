      !p_note_lock[0]  ? p_note[0]  = 36;  // Kick
      !p_note_lock[1]  ? p_note[1]  = 38;  // Snare
      !p_note_lock[2]  ? p_note[2]  = 37;  // Side Stick
      !p_note_lock[3]  ? p_note[3]  = 39;  // Clap
      !p_note_lock[4]  ? p_note[4]  = 42;  // HH Closed
      !p_note_lock[5]  ? p_note[5]  = 44;  // HH Pedal
      !p_note_lock[6]  ? p_note[6]  = 46;  // HH Open
      !p_note_lock[7]  ? p_note[7]  = 41;  // Tom Low
      !p_note_lock[8]  ? p_note[8]  = 47;  // Tom Mid
      !p_note_lock[9]  ? p_note[9]  = 50;  // Tom Hi
