      !p_note_lock[1]  ? p_note[1]  = 39;  // D#2
      !p_note_lock[2]  ? p_note[2]  = 42;  // F#2
      !p_note_lock[3]  ? p_note[3]  = 44;  // G#2
      !p_note_lock[4]  ? p_note[4]  = 46;  // A#2
