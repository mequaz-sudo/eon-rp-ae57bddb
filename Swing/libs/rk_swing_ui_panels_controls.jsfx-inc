  !oneshot_global ? gfx_set(0.20, 0.55, 0.85, 0.9) : gfx_set(0.28, 0.28, 0.30, 0.5);
  gfx_rect(_btn2_x, _os_y, _btn_w, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn2_x, _os_y, _btn_corner, 1); gfx_rect(_btn2_x, _os_y, 1, _btn_corner);
  gfx_rect(_btn2_x + _btn_w - _btn_corner, _os_y, _btn_corner, 1); gfx_rect(_btn2_x + _btn_w - 1, _os_y, 1, _btn_corner);
  gfx_rect(_btn2_x, _os_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn2_x, _os_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn2_x + _btn_w - _btn_corner, _os_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn2_x + _btn_w - 1, _os_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn2_x + _btn_corner, _os_y, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn2_x, _os_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn2_x + _btn_corner, _os_y + _btn_h - 1, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn2_x + _btn_w - 1, _os_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  !oneshot_global ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(_btn2_x + 1, _os_y + 1, _btn_w - 2, 1); );
  gfx_setfont(1, "Arial", 9, 'b');
  !oneshot_global ? gfx_set(0, 0, 0, 1) : gfx_set(0.45, 0.45, 0.48, 1);
  gfx_measurestr("GATE", tw, th);
  gfx_x = _btn2_x + (_btn_w - tw) / 2; gfx_y = _os_y + (_btn_h - th) / 2; gfx_drawstr("GATE");
  mx >= _btn2_x && mx <= _btn2_x+_btn_w && my >= _os_y && my <= _os_y+_btn_h ? swing_tooltip_check(17, "Global Gate mode — pads play only while the MIDI note is held; note-off cuts the voice. Opposite of 1-Shot.");
  mx >= _btn2_x && mx <= _btn2_x+_btn_w && my >= _os_y && my <= _os_y+_btn_h && lmb_down ? (
    oneshot_global ? ( oneshot_global = 0; mark_dirty(); );
  );

  // Third row: RPT | EXPLORE
  _btn5_y = _os_y + _btn_h + _btn_gap;

  // RPT button — red when active, blue when off
  repeat_div > 0 ? gfx_set(btn_red_r, btn_red_g, btn_red_b, 0.9) : gfx_set(btn_blue_r, btn_blue_g, btn_blue_b, 0.9);
  gfx_rect(_btn1_x, _btn5_y, _btn_w, _btn_h);
  // Round corners
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn1_x, _btn5_y, _btn_corner, 1); gfx_rect(_btn1_x, _btn5_y, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_w - _btn_corner, _btn5_y, _btn_corner, 1); gfx_rect(_btn1_x + _btn_w - 1, _btn5_y, 1, _btn_corner);
  gfx_rect(_btn1_x, _btn5_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x, _btn5_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_w - _btn_corner, _btn5_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x + _btn_w - 1, _btn5_y + _btn_h - _btn_corner, 1, _btn_corner);
  // Enhanced 3D bevel
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn1_x + _btn_corner, _btn5_y, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x, _btn5_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn1_x + _btn_corner, _btn5_y + _btn_h - 1, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x + _btn_w - 1, _btn5_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  // Inner glow for active state
  repeat_div > 0 ? (
    gfx_set(1, 1, 1, 0.10);
    gfx_rect(_btn1_x + 1, _btn5_y + 1, _btn_w - 2, 1);
  );
  gfx_setfont(1, "Arial", 8, 'b');
  gfx_set(1, 1, 1, 1);
  repeat_div == 0 ? strcpy(#_rpt_lbl, "RPT OFF") : (
    get_rpt_div_name(repeat_div); strcpy(#_rpt_lbl, #_rpt_name);
  );
  gfx_measurestr(#_rpt_lbl, tw, th);
  gfx_x = _btn1_x + (_btn_w - tw) / 2; gfx_y = _btn5_y + (_btn_h - th) / 2; gfx_drawstr(#_rpt_lbl);
  _in_rpt = mx >= _btn1_x && mx <= _btn1_x+_btn_w && my >= _btn5_y && my <= _btn5_y+_btn_h;
  _in_rpt ? swing_tooltip_check(1, "Repeat division for held notes — left-click cycles OFF/1/4/1/8/1/16/1/32/1/64; right-click for full menu (straight/triplet/dotted)");
  // Left-click: cycle straight divisions (OFF→1/4→1/8→1/16→1/32→1/64→OFF)
  _in_rpt && lmb_down ? (
    repeat_div == 0  ? repeat_div = 1  :  // OFF → 1/4
    repeat_div == 1  ? repeat_div = 4  :  // 1/4 → 1/8
    repeat_div == 4  ? repeat_div = 7  :  // 1/8 → 1/16
    repeat_div == 7  ? repeat_div = 10 :  // 1/16 → 1/32
    repeat_div == 10 ? repeat_div = 13 :  // 1/32 → 1/64
    repeat_div = 0;                        // anything else → OFF
    rpt_counter = 0; mark_dirty();
  );
  // Right-click: full menu with all divisions
  _in_rpt && rmb_down ? (
    resp = gfx_showmenu("OFF|1/4|1/4 T|1/4 D||1/8|1/8 T|1/8 D||1/16|1/16 T|1/16 D||1/32|1/32 T|1/32 D||1/64|1/64 T|1/64 D");
    resp > 0 ? (
      repeat_div = resp - 1;  // 1=OFF(0), 2=1/4(1), 3=1/4T(2), etc
      rpt_counter = 0; mark_dirty();
    );
  );
  // Scroll wheel: cycle through all divisions
  _in_rpt && frame_wheel != 0 ? (
    repeat_div = repeat_div + sign_of(frame_wheel);
    repeat_div < 0 ? repeat_div = RPT_NUM_DIVS;
    repeat_div > RPT_NUM_DIVS ? repeat_div = 0;
    rpt_counter = 0; mark_dirty();
  );

  // EXPLORER button — blue, teal when REAPER Media Explorer is open
  media_explorer_running ? gfx_set(0.20, 0.65, 0.55, 0.9) : gfx_set(btn_blue_r, btn_blue_g, btn_blue_b, 0.9);
  gfx_rect(_btn2_x, _btn5_y, _btn_w, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn2_x, _btn5_y, _btn_corner, 1); gfx_rect(_btn2_x, _btn5_y, 1, _btn_corner);
  gfx_rect(_btn2_x + _btn_w - _btn_corner, _btn5_y, _btn_corner, 1); gfx_rect(_btn2_x + _btn_w - 1, _btn5_y, 1, _btn_corner);
  gfx_rect(_btn2_x, _btn5_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn2_x, _btn5_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn2_x + _btn_w - _btn_corner, _btn5_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn2_x + _btn_w - 1, _btn5_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn2_x + _btn_corner, _btn5_y, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn2_x, _btn5_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn2_x + _btn_corner, _btn5_y + _btn_h - 1, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn2_x + _btn_w - 1, _btn5_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  media_explorer_running ? (
    gfx_set(1, 1, 1, 0.10);
    gfx_rect(_btn2_x + 1, _btn5_y + 1, _btn_w - 2, 1);
  );
  gfx_setfont(1, "Arial", 9, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr("EXPLORE", tw, th);
  gfx_x = _btn2_x + (_btn_w - tw) / 2; gfx_y = _btn5_y + (_btn_h - th) / 2; gfx_drawstr("EXPLORE");
  mx >= _btn2_x && mx <= _btn2_x+_btn_w && my >= _btn5_y && my <= _btn5_y+_btn_h ? swing_tooltip_check(18, "Toggle REAPER's Media Explorer. Drag samples directly from it onto pads.");
  mx >= _btn2_x && mx <= _btn2_x+_btn_w && my >= _btn5_y && my <= _btn5_y+_btn_h && lmb_down ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      gmem[KIT_GMEM_CMD] == 0 ? gmem[KIT_GMEM_CMD] = 45;
    ) : (
      kit_bridge_warn = 1;
    );
  );

  // BROWSE button — full width, opens EON Sample Browser via CMD 60
  _btn6_y = _btn5_y + _btn_h + _btn_gap;
  _btn6_w = _btn_w * 2 + _btn_gap;
  browser_running ? gfx_set(0.20, 0.65, 0.55, 0.9) : gfx_set(btn_blue_r, btn_blue_g, btn_blue_b, 0.9);
  gfx_rect(_btn1_x, _btn6_y, _btn6_w, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn1_x, _btn6_y, _btn_corner, 1); gfx_rect(_btn1_x, _btn6_y, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn6_w - _btn_corner, _btn6_y, _btn_corner, 1); gfx_rect(_btn1_x + _btn6_w - 1, _btn6_y, 1, _btn_corner);
  gfx_rect(_btn1_x, _btn6_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x, _btn6_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn6_w - _btn_corner, _btn6_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x + _btn6_w - 1, _btn6_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn1_x + _btn_corner, _btn6_y, _btn6_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x, _btn6_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn1_x + _btn_corner, _btn6_y + _btn_h - 1, _btn6_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x + _btn6_w - 1, _btn6_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  browser_running ? (
    gfx_set(1, 1, 1, 0.10);
    gfx_rect(_btn1_x + 1, _btn6_y + 1, _btn6_w - 2, 1);
  );
  gfx_setfont(1, "Arial", 9, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr("BROWSE", tw, th);
  gfx_x = _btn1_x + (_btn6_w - tw) / 2; gfx_y = _btn6_y + (_btn_h - th) / 2; gfx_drawstr("BROWSE");
  mx >= _btn1_x && mx <= _btn1_x+_btn6_w && my >= _btn6_y && my <= _btn6_y+_btn_h ? swing_tooltip_check(19, "Open the Swing sample browser (categorized file list, audio preview, drag-to-pad). Requires ReaImGui — see banner if not installed.");
  mx >= _btn1_x && mx <= _btn1_x+_btn6_w && my >= _btn6_y && my <= _btn6_y+_btn_h && lmb_down ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      gmem[KIT_GMEM_CMD] == 0 ? (
        gmem[KIT_GMEM_PARAM1] = sel_pad;  // target pad for browser-driven action
        // Claim browser routing: subsequent CMD 63/64 sample loads + the
        // browser's window-size and pad-select sync land on this instance,
        // not on whatever other Swing instance happens to also be running.
        gmem[KIT_GMEM_INSTANCE] = instance_id;
        gmem[KIT_GMEM_CMD] = 60;    // CMD 60 = open browser
      );
    ) : (
      kit_bridge_warn = 1;
    );
  );

  // ── Preferences row: SEL TRK + TIPS toggles ───────────────────────
  // Two side-by-side toggle buttons between BROWSE and CLEAR.
  //   SEL TRK: when ON, clicking a pad selects the matching multi-out
  //            track in REAPER's TCP (gated on bridge alive in pad
  //            click handler). Off by default; opt-in.
  //   TIPS:    toggles the global tooltip overlay. Default ON.
  _btn8_y = _btn6_y + _btn_h + _btn_gap;

  // SEL TRK (left)
  pad_click_selects_track ? gfx_set(0.20, 0.65, 0.55, 0.9) : gfx_set(btn_blue_r, btn_blue_g, btn_blue_b, 0.9);
  gfx_rect(_btn1_x, _btn8_y, _btn_w, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn1_x, _btn8_y, _btn_corner, 1); gfx_rect(_btn1_x, _btn8_y, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_w - _btn_corner, _btn8_y, _btn_corner, 1); gfx_rect(_btn1_x + _btn_w - 1, _btn8_y, 1, _btn_corner);
  gfx_rect(_btn1_x, _btn8_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x, _btn8_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_w - _btn_corner, _btn8_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x + _btn_w - 1, _btn8_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn1_x + _btn_corner, _btn8_y, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x, _btn8_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn1_x + _btn_corner, _btn8_y + _btn_h - 1, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x + _btn_w - 1, _btn8_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_setfont(1, "Arial", 8, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr("SEL TRK", tw, th);
  gfx_x = _btn1_x + (_btn_w - tw) / 2; gfx_y = _btn8_y + (_btn_h - th) / 2; gfx_drawstr("SEL TRK");
  _in_seltrk = mx >= _btn1_x && mx <= _btn1_x+_btn_w && my >= _btn8_y && my <= _btn8_y+_btn_h;
  _in_seltrk ? swing_tooltip_check(22, "When ON, clicking a pad selects the corresponding multi-out child track in REAPER's TCP and scrolls it into view. Requires MULTI mode + multi-out tracks built via LOAD right-click.");
  _in_seltrk && lmb_down ? (
    pad_click_selects_track = !pad_click_selects_track;
    mark_dirty();  // persist via the dirty counter
  );

  // TIPS (right) — global tooltip on/off toggle
  tooltips_enabled ? gfx_set(0.20, 0.65, 0.55, 0.9) : gfx_set(btn_blue_r, btn_blue_g, btn_blue_b, 0.9);
  gfx_rect(_btn2_x, _btn8_y, _btn_w, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn2_x, _btn8_y, _btn_corner, 1); gfx_rect(_btn2_x, _btn8_y, 1, _btn_corner);
  gfx_rect(_btn2_x + _btn_w - _btn_corner, _btn8_y, _btn_corner, 1); gfx_rect(_btn2_x + _btn_w - 1, _btn8_y, 1, _btn_corner);
  gfx_rect(_btn2_x, _btn8_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn2_x, _btn8_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn2_x + _btn_w - _btn_corner, _btn8_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn2_x + _btn_w - 1, _btn8_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn2_x + _btn_corner, _btn8_y, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn2_x, _btn8_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn2_x + _btn_corner, _btn8_y + _btn_h - 1, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn2_x + _btn_w - 1, _btn8_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_setfont(1, "Arial", 8, 'b');
  gfx_set(1, 1, 1, 1);
  strcpy(#_tips_lbl, tooltips_enabled ? "TIPS ON" : "TIPS OFF");
  gfx_measurestr(#_tips_lbl, tw, th);
  gfx_x = _btn2_x + (_btn_w - tw) / 2; gfx_y = _btn8_y + (_btn_h - th) / 2; gfx_drawstr(#_tips_lbl);
  _in_tips = mx >= _btn2_x && mx <= _btn2_x+_btn_w && my >= _btn8_y && my <= _btn8_y+_btn_h;
  _in_tips ? swing_tooltip_check(23, "Toggle hover tooltips on or off. When OFF, no tooltips appear over any control.");
  _in_tips && lmb_down ? (
    tooltips_enabled = !tooltips_enabled;
    mark_dirty();
  );

  // ── Group 3/4 divider ──
  _div3_y = _btn8_y + _btn_h + 4;
  gfx_set(0.30, 0.35, 0.38, 0.5);
  gfx_rect(8, _div3_y, left_w - 16, 1);

  // Fourth row: CLEAR (full width — REAPER's Ctrl+Z handles undo for clear/swap/load via the deferred CMD 46/48 system)
  _btn7_y = _div3_y + 5;
  _btn_full_w = _btn_w * 2 + _btn_gap;

  // CLEAR ALL button — red, clears all 16 pads (with confirmation)
  gfx_set(btn_red_r, btn_red_g, btn_red_b, 0.9);
  gfx_rect(_btn1_x, _btn7_y, _btn_full_w, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn1_x, _btn7_y, _btn_corner, 1); gfx_rect(_btn1_x, _btn7_y, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_full_w - _btn_corner, _btn7_y, _btn_corner, 1); gfx_rect(_btn1_x + _btn_full_w - 1, _btn7_y, 1, _btn_corner);
  gfx_rect(_btn1_x, _btn7_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x, _btn7_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_full_w - _btn_corner, _btn7_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x + _btn_full_w - 1, _btn7_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn1_x + _btn_corner, _btn7_y, _btn_full_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x, _btn7_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn1_x + _btn_corner, _btn7_y + _btn_h - 1, _btn_full_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x + _btn_full_w - 1, _btn7_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_setfont(1, "Arial", 9, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr("CLEAR", tw, th);
  gfx_x = _btn1_x + (_btn_full_w - tw) / 2; gfx_y = _btn7_y + (_btn_h - th) / 2; gfx_drawstr("CLEAR");
  mx >= _btn1_x && mx <= _btn1_x+_btn_full_w && my >= _btn7_y && my <= _btn7_y+_btn_h ? swing_tooltip_check(20, "Clear all 16 pads (audio + names + per-pad FX). Asks for confirmation. Ctrl+Z restores everything via REAPER's undo.");
  mx >= _btn1_x && mx <= _btn1_x+_btn_full_w && my >= _btn7_y && my <= _btn7_y+_btn_h && lmb_down ? (
    resp = gfx_showmenu("Clear all pads (keep kit name + FX)?|---| ");
    resp == 1 ? (
      // Queue clear all — deferred until bridge opens undo block
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 ? (
        gmem[KIT_GMEM_UNDO_DESC] = 1;
        gmem[KIT_GMEM_CMD] = 46;
        _undo_pending = 1;
      ) : (
        // Bridge not alive — execute immediately (no undo)
        gi = 0; loop(NUM_PADS, clear_pad(gi); gi += 1;);
      );
    );
  );

);

function swing_panels_draw_master() (
  // Available area below last button row
  _ctrl_area_y = _btn7_y + _btn_h + 8;
  _ctrl_area_h = gfx_h - _ctrl_area_y - 6;

  // Side-by-side layout: DRIVE on left, VOL on right
  _drv_zone_w = (left_w * 0.28)|0;
  _knob_zone_w = left_w - _drv_zone_w;

  // Master VOL knob sizing (fits right side of left panel — BIG).
  // Cap was 42 (height) — raised to 65 so the knob keeps growing on
  // stretched windows without becoming oversized. Width and height fits
  // still dominate on small windows; the cap is just a sanity ceiling.
  _mvol_r = min(65, (_ctrl_area_h - 16) / 2);
  _mvol_r = min(_mvol_r, (_knob_zone_w / 2 - 8));
  _mvol_r = max(26, _mvol_r);

  // DRIVE fader (left side, vertically centered in zone).
  // Cap raised from 90 to 180 so the fader scales on big windows.
  _drv_h = min(180, _ctrl_area_h - 18);
  _drv_cx = 4 + _drv_zone_w / 2;
  _drv_y = _ctrl_area_y + ((_ctrl_area_h - _drv_h - 14) / 2)|0;
  _drv_track_w = 6;       // wider track
  _drv_thumb_w = 28;      // wider thumb
  _drv_thumb_h = 12;

  // Track (wider dark groove)
  _drv_track_x = _drv_cx - (_drv_track_w / 2)|0;
  gfx_set(0.06, 0.06, 0.08, 1);
  gfx_rect(_drv_track_x, _drv_y, _drv_track_w, _drv_h);
  // Track inset bevel
  gfx_set(0.03, 0.03, 0.05, 0.8);
  gfx_rect(_drv_track_x, _drv_y, _drv_track_w, 1);
  gfx_rect(_drv_track_x, _drv_y, 1, _drv_h);
  gfx_set(0.20, 0.20, 0.22, 0.4);
  gfx_rect(_drv_track_x, _drv_y + _drv_h - 1, _drv_track_w, 1);

  // Blue center indicator line (shows current drive level in the track)
  _drv_fill_h = (gfx_sat_drv * _drv_h)|0;
  _drv_fill_h > 0 ? (
    gfx_set(btn_blue_r * 0.7, btn_blue_g * 0.8, btn_blue_b * 1.0, 0.85);
    gfx_rect(_drv_track_x + 1, _drv_y + _drv_h - _drv_fill_h, _drv_track_w - 2, _drv_fill_h);
  );

  // Tick marks (5 ticks on left side)
  gfx_set(0.50, 0.48, 0.45, 0.5);
  _ti = 0; loop(5,
    _tick_y = (_drv_y + (_ti / 4.0) * _drv_h)|0;
    gfx_line(_drv_track_x - 4, _tick_y, _drv_track_x - 1, _tick_y);
    _ti += 1;
  );

  // Thumb position
  _drv_thumb_y = _drv_y + (1.0 - gfx_sat_drv) * (_drv_h - _drv_thumb_h);
  _drv_thumb_x = _drv_cx - (_drv_thumb_w / 2)|0;

  // Thumb cap (metallic silver)
  gfx_set(0.62, 0.60, 0.57, 1);
  gfx_rect(_drv_thumb_x, _drv_thumb_y, _drv_thumb_w, _drv_thumb_h);
  // Top highlight
  gfx_set(0.82, 0.80, 0.77, 0.7);
  gfx_rect(_drv_thumb_x, _drv_thumb_y, _drv_thumb_w, 1);
  gfx_rect(_drv_thumb_x, _drv_thumb_y, 1, _drv_thumb_h);
  // Bottom/right shadow
  gfx_set(0.28, 0.26, 0.23, 0.7);
  gfx_rect(_drv_thumb_x, _drv_thumb_y + _drv_thumb_h - 1, _drv_thumb_w, 1);
  gfx_rect(_drv_thumb_x + _drv_thumb_w - 1, _drv_thumb_y, 1, _drv_thumb_h);
  // Blue center line on thumb
  gfx_set(btn_blue_r * 0.6, btn_blue_g * 0.7, btn_blue_b * 0.9, 0.8);
  gfx_rect(_drv_thumb_x + 4, _drv_thumb_y + (_drv_thumb_h / 2)|0, _drv_thumb_w - 8, 2);

  // Drive interaction (vertical drag, ID 270)
  active_id == 270 ? ( LMB ? (
    gfx_sat_drv = max(0, min(1.0, 1.0 - (my - _drv_y) / _drv_h));
    mark_dirty();
  ) : active_id = -1; );

  active_id == -1 && mx >= _drv_thumb_x - 4 && mx <= _drv_thumb_x + _drv_thumb_w + 4 && my >= _drv_y && my <= _drv_y + _drv_h && lmb_down ? (
    active_id = 270;
  );

  // Tooltip: zone 3 = master DRIVE fader. Hover zone uses the same
  // hitbox as the click + scroll detectors above.
  mx >= _drv_thumb_x - 6 && mx <= _drv_thumb_x + _drv_thumb_w + 6 && my >= _drv_y && my <= _drv_y + _drv_h ?
    swing_tooltip_check(3, "Master DRIVE — saturation amount applied at the final stage. 0 = clean, 1 = fully saturated. Drag thumb, scroll wheel, or double-click to reset.");

  // Drive scroll wheel — anywhere over the fader column adjusts the
  // drive amount. Matches the wheel sensitivity of the LCD 0..1 knobs
  // (delay feedback / mix etc., 0.02 per tick = 50 ticks full range).
  // Hitbox uses the thumb width plus a 6px gutter so the user can land
  // the scroll without aiming exactly at the moving thumb.
  mx >= _drv_thumb_x - 6 && mx <= _drv_thumb_x + _drv_thumb_w + 6 && my >= _drv_y && my <= _drv_y + _drv_h && frame_wheel != 0 ? (
    gfx_sat_drv = max(0, min(1.0, gfx_sat_drv + frame_wheel * 0.02));
    mark_dirty();
  );

  // Drive label — dark on cream panel for contrast
  gfx_setfont(1, "Arial", 10, 'b');
  gfx_set(0.18, 0.16, 0.14, 1.0);
  gfx_measurestr("DRIVE", tw, th);
  gfx_x = _drv_cx - tw / 2; gfx_y = _drv_y + _drv_h + 4; gfx_drawstr("DRIVE");

  // ── Master VOL jog wheel knob (centered in knob zone) ──
  _mvol_cx = _drv_zone_w + _knob_zone_w / 2;
  _mvol_cy = _ctrl_area_y + (_ctrl_area_h / 2)|0;

  // Master vol is now logged as dB (ver 40+). Knob reads -60..+12 dB,
  // default 0 dB = unity gain. Conversion to linear amplitude happens
  // in Swing_ReaKit.jsfx @slider where it sets global_vol from master_db.
  // Tooltip: zone 21 = master VOL knob. Hitbox matches the interact zone.
  _mvol_dx = mx - _mvol_cx; _mvol_dy = my - _mvol_cy;
  _mvol_dx*_mvol_dx + _mvol_dy*_mvol_dy <= (_mvol_r+6)*(_mvol_r+6) ?
    swing_tooltip_check(21, "Master output volume (-60 dB silence to +12 dB). Drag, scroll, or double-click to reset to 0 dB (unity).");
  jog_knob_draw(_mvol_cx, _mvol_cy, _mvol_r, master_db, -60, 12, km_master_vol[0],
                0.15, 0.55, 1.0);

  // Interact: drag, scroll, double-click reset to 0 dB (unity)
  nv = jog_knob_interact(km_master_vol, _mvol_cx, _mvol_cy, _mvol_r + 6, master_db, -60, 12, 0, 0);
  nv != master_db ? (
    master_db = nv;
    slider2 = master_db;
    slider_automate(slider2);
    // Recompute global_vol immediately so the next @sample uses the new amp
    // (don't wait for @slider — it fires on the NEXT block boundary).
    global_vol = master_db <= -60 ? 0 : exp(master_db * 0.11512925465);
  );

  // Label: MASTER VOL (bold) — dark on cream panel for contrast
  gfx_setfont(1, "Arial", 10, 'b');
  gfx_set(0.18, 0.16, 0.14, 1.0);
  gfx_measurestr("MASTER VOL", tw, th);
  gfx_x = _mvol_cx - tw / 2; gfx_y = _mvol_cy + _mvol_r + 10; gfx_drawstr("MASTER VOL");

  // Tooltip rendering happens once at end of @gfx via swing_tooltip_draw()
  // in Swing_ReaKit.jsfx. Hover-site swing_tooltip_check() calls above
  // have already set the render text + zone-tracking state.
);
