// rk_swing_ui_panels_controls.jsfx-inc
// Swing left panel: buttons (SAVE/LOAD, COLORS, STEREO, VEL, MAP, RPT, EXPLORE, BROWSE, CLEAR, UNDO/REDO) + master DRIVE/VOL
// (c) EON Studios — All Rights Reserved

@init

function swing_panels_draw_controls() (
  // Tooltip state + render lives in rk_swing_tooltips.jsfx-inc.
  // Per-control hover sites call swing_tooltip_check(zone_id, text);
  // swing_tooltip_draw() is called once at end of @gfx from
  // Swing_ReaKit.jsfx (renders the box, resets per-frame state).

  // Button appearance (must be defined before first use)
  _btn_corner = 2;
  _btn_cream_r = 0.78; _btn_cream_g = 0.76; _btn_cream_b = 0.72;

  // Button grid area (below LCD panel)
  _btn_area_y = lcd_y + lcd_h + 4;
  _btn_area_h = left_h - (lcd_y - left_y + lcd_h + 4);
  _btn_w = (left_w - 12) / 2;
  _btn_h = 28;
  _btn_gap = 4;

  // Row 0: SAVE KIT | LOAD KIT | NEW KIT
  _bk0_y = _btn_area_y;
  _btn_w3 = ((left_w - 12) - _btn_gap * 2) / 3;  // 3-button width
  _bk1_x = 4; _bk2_x = _bk1_x + _btn_w3 + _btn_gap; _bk3_x = _bk2_x + _btn_w3 + _btn_gap;

  // ── SAVE KIT button ── (amber)
  _kit_sav_active = kit_busy && kit_export_state > 0;
  _kit_sav_active ? gfx_set(0.85, 0.55, 0.15, 0.9) : gfx_set(0.40, 0.32, 0.15, 1);
  gfx_rect(_bk1_x, _bk0_y, _btn_w3, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_bk1_x, _bk0_y, _btn_corner, 1); gfx_rect(_bk1_x, _bk0_y, 1, _btn_corner);
  gfx_rect(_bk1_x + _btn_w3 - _btn_corner, _bk0_y, _btn_corner, 1); gfx_rect(_bk1_x + _btn_w3 - 1, _bk0_y, 1, _btn_corner);
  gfx_rect(_bk1_x, _bk0_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_bk1_x, _bk0_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_bk1_x + _btn_w3 - _btn_corner, _bk0_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_bk1_x + _btn_w3 - 1, _bk0_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_bk1_x + _btn_corner, _bk0_y, _btn_w3 - _btn_corner * 2, 1);
  gfx_rect(_bk1_x, _bk0_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_bk1_x + _btn_corner, _bk0_y + _btn_h - 1, _btn_w3 - _btn_corner * 2, 1);
  gfx_rect(_bk1_x + _btn_w3 - 1, _bk0_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  _kit_sav_active ? (
    gfx_set(1, 1, 1, 0.10);
    gfx_rect(_bk1_x + 1, _bk0_y + 1, _btn_w3 - 2, 1);
  );
  gfx_setfont(1, "Arial", 9, 'b');
  _kit_sav_active ? gfx_set(1, 1, 1, 1) : gfx_set(0.70, 0.68, 0.65, 1);
  gfx_measurestr("SAVE", tw, th);
  gfx_x = _bk1_x + (_btn_w3 - tw) / 2; gfx_y = _bk0_y + (_btn_h - th) / 2; gfx_drawstr("SAVE");
  _in_save = !kit_busy && mx >= _bk1_x && mx <= _bk1_x+_btn_w3 && my >= _bk0_y && my <= _bk0_y+_btn_h;
  _in_save ? swing_tooltip_check(10, "Save the current kit. Left-click prompts for a name; right-click for Save As (browse PC).");
  // LOCK + CMD must be written in the SAME @gfx evaluation. Bridge has a
  // stale-LOCK self-heal in poll_sidecar_events that clears LOCK whenever
  // it sees CMD==0 && LOCK!=0 — if we write LOCK here and let state 1 write
  // CMD=10 on the next tick, the self-heal can fire in the gap and clear
  // our LOCK before the save flow ever reaches the bridge. Same pattern
  // as the LOAD button (line ~90), which writes LOCK + CMD=2 atomically.
  // Skip state 1 entirely and go straight to state 10 with CMD already set.
  _in_save && lmb_down ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      gmem[KIT_GMEM_LOCK] = instance_id;
      gmem[KIT_GMEM_CMD]  = 10;
      kit_export_state = 10;
      kit_busy = 1;
    ) : (
      kit_bridge_warn = 1;
    );
  );
  // Right-click SAVE → extended save options
  _in_save && rmb_down ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      resp = gfx_showmenu("Save Kit (.swing)|Save Kit As... (Browse PC)");
      // Both branches acquire LOCK + set CMD atomically — see comment on
      // left-click handler above for the race we're avoiding.
      resp == 1 ? (
        gmem[KIT_GMEM_LOCK] = instance_id;
        gmem[KIT_GMEM_CMD]  = 10;
        kit_export_state = 10;
        kit_busy = 1;
      );
      resp == 2 ? (
        gmem[KIT_GMEM_LOCK] = instance_id;
        gmem[KIT_GMEM_CMD]  = 15;
        kit_export_state = 10;
        kit_busy = 1;
      );
    ) : (
      kit_bridge_warn = 1;
    );
  );

  // ── LOAD KIT button ── (blue)
  _kit_lod_active = kit_busy && kit_import_state > 0;
  _kit_lod_active ? gfx_set(0.20, 0.55, 0.85, 0.9) : gfx_set(0.18, 0.28, 0.42, 1);
  gfx_rect(_bk2_x, _bk0_y, _btn_w3, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_bk2_x, _bk0_y, _btn_corner, 1); gfx_rect(_bk2_x, _bk0_y, 1, _btn_corner);
  gfx_rect(_bk2_x + _btn_w3 - _btn_corner, _bk0_y, _btn_corner, 1); gfx_rect(_bk2_x + _btn_w3 - 1, _bk0_y, 1, _btn_corner);
  gfx_rect(_bk2_x, _bk0_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_bk2_x, _bk0_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_bk2_x + _btn_w3 - _btn_corner, _bk0_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_bk2_x + _btn_w3 - 1, _bk0_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_bk2_x + _btn_corner, _bk0_y, _btn_w3 - _btn_corner * 2, 1);
  gfx_rect(_bk2_x, _bk0_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_bk2_x + _btn_corner, _bk0_y + _btn_h - 1, _btn_w3 - _btn_corner * 2, 1);
  gfx_rect(_bk2_x + _btn_w3 - 1, _bk0_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  _kit_lod_active ? (
    gfx_set(1, 1, 1, 0.10);
    gfx_rect(_bk2_x + 1, _bk0_y + 1, _btn_w3 - 2, 1);
  );
  gfx_setfont(1, "Arial", 9, 'b');
  _kit_lod_active ? gfx_set(1, 1, 1, 1) : gfx_set(0.70, 0.68, 0.65, 1);
  gfx_measurestr("LOAD", tw, th);
  gfx_x = _bk2_x + (_btn_w3 - tw) / 2; gfx_y = _bk0_y + (_btn_h - th) / 2; gfx_drawstr("LOAD");
  _in_load = !kit_busy && mx >= _bk2_x && mx <= _bk2_x+_btn_w3 && my >= _bk0_y && my <= _bk0_y+_btn_h;
  _in_load ? swing_tooltip_check(11, "Load a kit. Left-click opens the kit browser; right-click for Browse PC / Import SFZ / Batch Import Folder / Chop Selection to Pads.");
  _in_load && lmb_down ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      gmem[KIT_GMEM_LOCK] = instance_id;
      gmem[KIT_GMEM_CMD] = 2;
      kit_import_state = 1;
      kit_busy = 1;
    ) : (
      kit_bridge_warn = 1;
    );
  );
  // Right-click LOAD → import / utility menu
  _in_load && rmb_down ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      resp = gfx_showmenu("Load Kit (.swing)|Load Kit From... (Browse PC)|Import SFZ Kit...||Batch Import Folder|Chop Selection to Pads");
      // 1=Load Kit, 2=Browse PC, 3=Import SFZ, 4=Batch, 5=Chop
      resp == 1 ? ( gmem[KIT_GMEM_LOCK] = instance_id; gmem[KIT_GMEM_CMD] = 2;  kit_import_state = 1; kit_busy = 1; );
      resp == 2 ? ( gmem[KIT_GMEM_LOCK] = instance_id; gmem[KIT_GMEM_CMD] = 16; kit_import_state = 1; kit_busy = 1; );
      resp == 3 ? ( gmem[KIT_GMEM_CMD] = 17; );  // file dialog → import_start (handled async by browser, no kit_busy)
      resp == 4 ? ( gmem[KIT_GMEM_LOCK] = instance_id; gmem[KIT_GMEM_CMD] = 20; kit_import_state = 1; kit_busy = 1; );
      resp == 5 ? ( gmem[KIT_GMEM_LOCK] = instance_id; gmem[KIT_GMEM_CMD] = 30; kit_import_state = 1; kit_busy = 1; );
    ) : (
      kit_bridge_warn = 1;
    );
  );

  // ── NEW KIT button ── (coral/red)
  gfx_set(0.42, 0.20, 0.18, 1);
  gfx_rect(_bk3_x, _bk0_y, _btn_w3, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_bk3_x, _bk0_y, _btn_corner, 1); gfx_rect(_bk3_x, _bk0_y, 1, _btn_corner);
  gfx_rect(_bk3_x + _btn_w3 - _btn_corner, _bk0_y, _btn_corner, 1); gfx_rect(_bk3_x + _btn_w3 - 1, _bk0_y, 1, _btn_corner);
  gfx_rect(_bk3_x, _bk0_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_bk3_x, _bk0_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_bk3_x + _btn_w3 - _btn_corner, _bk0_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_bk3_x + _btn_w3 - 1, _bk0_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_bk3_x + _btn_corner, _bk0_y, _btn_w3 - _btn_corner * 2, 1);
  gfx_rect(_bk3_x, _bk0_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_bk3_x + _btn_corner, _bk0_y + _btn_h - 1, _btn_w3 - _btn_corner * 2, 1);
  gfx_rect(_bk3_x + _btn_w3 - 1, _bk0_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_setfont(1, "Arial", 9, 'b');
  gfx_set(0.70, 0.68, 0.65, 1);
  gfx_measurestr("NEW", tw, th);
  gfx_x = _bk3_x + (_btn_w3 - tw) / 2; gfx_y = _bk0_y + (_btn_h - th) / 2; gfx_drawstr("NEW");
  _in_new = !kit_busy && mx >= _bk3_x && mx <= _bk3_x+_btn_w3 && my >= _bk0_y && my <= _bk0_y+_btn_h;
  _in_new ? swing_tooltip_check(12, "New empty kit — clears all pads, resets FX, removes the kit name.");
  _in_new && lmb_down ? (
    resp = gfx_showmenu("New Kit - Clear pads, name, and FX chain?");
    resp == 1 ? (
      // Full reset (pads + name + FX) via deferred undo path.
      // (CLEAR button is the "pads only, keep name + FX" sibling action.)
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 ? (
        gmem[KIT_GMEM_UNDO_DESC] = 6;
        gmem[KIT_GMEM_CMD] = 46;
        _undo_pending = 6;
      ) : (
        // Bridge not alive — execute immediately (no undo)
        swing_new_kit_full_reset();
      );
    );
  );

  // ── Group 1/2 divider ──
  _div1_y = _bk0_y + _btn_h + 4;
  gfx_set(0.30, 0.35, 0.38, 0.5);
  gfx_rect(8, _div1_y, left_w - 16, 1);

  // First row: COLORS | STEREO/MULTI
  _btn1_x = 4; _btn1_y = _div1_y + 5;
  _btn2_x = _btn1_x + _btn_w + _btn_gap; _btn2_y = _btn1_y;

  // COLORS button — left-click toggles inline Color Panel; right-click
  // reveals a small menu (currently: "Reset all pad colors to default").
  // The palette/theme menu was removed in v43 when the color system
  // simplified to auto-color modes + Mono + intensity.
  gfx_set(_btn_cream_r, _btn_cream_g, _btn_cream_b, 1);
  gfx_rect(_btn1_x, _btn1_y, _btn_w, _btn_h);
  gfx_set(_btn_cream_r * 0.6, _btn_cream_g * 0.55, _btn_cream_b * 0.50, 0.25);
  gfx_rect(_btn1_x, _btn1_y + _btn_h, _btn_w, 1);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn1_x, _btn1_y, _btn_corner, 1); gfx_rect(_btn1_x, _btn1_y, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_w - _btn_corner, _btn1_y, _btn_corner, 1); gfx_rect(_btn1_x + _btn_w - 1, _btn1_y, 1, _btn_corner);
  gfx_rect(_btn1_x, _btn1_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x, _btn1_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_w - _btn_corner, _btn1_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x + _btn_w - 1, _btn1_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn1_x + _btn_corner, _btn1_y, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x, _btn1_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn1_x + _btn_corner, _btn1_y + _btn_h - 1, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn1_x + _btn_w - 1, _btn1_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_setfont(1, "Arial", 9, 'b');
  gfx_set(0.20, 0.20, 0.22, 1);
  gfx_measurestr("COLORS", tw, th);
  gfx_x = _btn1_x + (_btn_w - tw) / 2; gfx_y = _btn1_y + (_btn_h - th) / 2; gfx_drawstr("COLORS");
  _in_colors = mx >= _btn1_x && mx <= _btn1_x+_btn_w && my >= _btn1_y && my <= _btn1_y+_btn_h;
  _in_colors ? swing_tooltip_check(13, "Open Color Panel — auto-color modes (Off / DrumType / Output / Folder), Mono toggle, and intensity slider. Right-click to reset all pad colors to default.");
  // Click toggles the Color Panel inline (auto-color mode, Mono, intensity).
  // Themes + palettes + Auto-Color-by-name bulk action were removed in v43
  // (the color system simplified to: auto-color modes + Mono + intensity).
  _in_colors && lmb_down ? (
    col_panel_open = !col_panel_open;
  );
  // Right-click: reset all pad colors to the evenly-spaced rainbow default
  // (i / 16.0 for pad i). Clears any manual overrides, black/white markers,
  // and lets the auto-color mode (if active) re-derive col_auto_hue on the
  // next sample/output/folder change. Menu confirmation prevents accidental
  // nuking of carefully-tuned hues.
  _in_colors && rmb_down ? (
    resp = gfx_showmenu("Reset all pad colors to default");
    resp == 1 ? (
      gi = 0;
      loop(NUM_PADS,
        p_color[gi] = gi / 16.0;
        gi += 1;
      );
      col_dirty = 1;
      mark_dirty();
    );
  );

  // Color panel (inline, below COLORS button when open)
  col_panel_open ? (
    col_panel_h = swing_color_draw_panel(_btn1_x, _btn1_y + _btn_h + 2, left_w - 8);
  ) : (
    col_panel_h = 0;
  );

  // STEREO / MULTI toggle button — hidden when color panel open
  _btn2_y = _btn1_y;
  !col_panel_open ? (
  multi_out ? gfx_set(btn_blue_r, btn_blue_g, btn_blue_b, 0.9) : gfx_set(btn_red_r, btn_red_g, btn_red_b, 0.9);
  gfx_rect(_btn2_x, _btn2_y, _btn_w, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn2_x, _btn2_y, _btn_corner, 1); gfx_rect(_btn2_x, _btn2_y, 1, _btn_corner);
  gfx_rect(_btn2_x + _btn_w - _btn_corner, _btn2_y, _btn_corner, 1); gfx_rect(_btn2_x + _btn_w - 1, _btn2_y, 1, _btn_corner);
  gfx_rect(_btn2_x, _btn2_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn2_x, _btn2_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_rect(_btn2_x + _btn_w - _btn_corner, _btn2_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn2_x + _btn_w - 1, _btn2_y + _btn_h - _btn_corner, 1, _btn_corner);
  gfx_set(1, 1, 1, 0.15); gfx_rect(_btn2_x + _btn_corner, _btn2_y, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn2_x, _btn2_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(0, 0, 0, 0.20);
  gfx_rect(_btn2_x + _btn_corner, _btn2_y + _btn_h - 1, _btn_w - _btn_corner * 2, 1);
  gfx_rect(_btn2_x + _btn_w - 1, _btn2_y + _btn_corner, 1, _btn_h - _btn_corner * 2);
  gfx_set(1, 1, 1, 0.10);
  gfx_rect(_btn2_x + 1, _btn2_y + 1, _btn_w - 2, 1);
  gfx_setfont(1, "Arial", 8, 'b');
  gfx_set(1, 1, 1, 1);
  multi_out ? strcpy(#_mo_lbl, "MULTI") : strcpy(#_mo_lbl, "STEREO");
  gfx_measurestr(#_mo_lbl, tw, th);
  gfx_x = _btn2_x + (_btn_w - tw) / 2; gfx_y = _btn2_y + (_btn_h - th) / 2; gfx_drawstr(#_mo_lbl);
  _in_multi = mx >= _btn2_x && mx <= _btn2_x+_btn_w && my >= _btn2_y && my <= _btn2_y+_btn_h;
  _in_multi ? swing_tooltip_check(14, "Toggle output routing. STEREO = all pads to channels 1-2; MULTI = each pad to its own stereo pair (1-2, 3-4, ... 31-32) for per-pad track mixing. Use the MULTI builder via LOAD right-click to create child tracks.");
  // Left-click: toggle — immediately enforce outputs on all pads
  _in_multi && lmb_down ? (
    multi_out = !multi_out;
    multi_out ? (
      // Switching to MULTI: auto-assign 1 per pad
      gi = 0; loop(NUM_PADS, p_output[gi] = gi; gi += 1;);
    ) : (
      // Switching to STEREO: reset all to Out 1
      gi = 0; loop(NUM_PADS, p_output[gi] = 0; gi += 1;);
    );
    mark_dirty();
  );
  // Right-click: output & routing options
  _in_multi && rmb_down ? (
    resp = gfx_showmenu("Auto Assign (1 per pad)|Reset All to Out 1||Build Multi-Out Tracks");
    resp == 1 ? (
      gi = 0; loop(NUM_PADS, p_output[gi] = gi; gi += 1;);
      multi_out = 1; mark_dirty();
    );
    resp == 2 ? (
      gi = 0; loop(NUM_PADS, p_output[gi] = 0; gi += 1;);
      multi_out = 0; mark_dirty();
    );
    resp == 3 ? (
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
        // Acquire lock + sync pad data for multi-out builder
        gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id ? (
          // Switch to MULTI routing + auto-assign one channel per pad up front
          // so the JSFX is already in multi-out mode by the time the bridge
          // finishes creating the destination tracks. Without this, user would
          // see all 16 tracks created but Swing still summing to stereo Out 1
          // until they clicked the MULTI/STEREO toggle.
          multi_out = 1;
          gi = 0; loop(NUM_PADS, p_output[gi] = gi; gi += 1;);
          mark_dirty();
          gmem[KIT_GMEM_LOCK] = instance_id;
          _ki = 0; loop(NUM_PADS,
            _cn = get_cname_slot(_ki);
            _cnl = strlen(_cn);
            _cj = 0; loop(KIT_GMEM_PADNAME_LEN,
              gmem[KIT_GMEM_PADNAMES + _ki * KIT_GMEM_PADNAME_LEN + _cj] =
                _cj < _cnl ? str_getchar(_cn, _cj) : 0;
              _cj += 1;
            );
            gmem[KIT_GMEM_META + _ki * KIT_GMEM_META_PP + 12] = p_color[_ki];
            _ki += 1;
          );
          gmem[KIT_GMEM_CMD] = 40; kit_import_state = 1; kit_busy = 1;
        ) : (
          kit_bridge_warn = 2; // 2 = bridge busy
        );
      ) : (
        kit_bridge_warn = 1;
      );
    );
  );
  ); // end !col_panel_open

  // Second row: VEL curve | BASE note
  col_panel_open ? (
    _btn3_y = _btn1_y + _btn_h + 2 + col_panel_h + _btn_gap;
  ) : (
    _btn3_y = _btn2_y + _btn_h + _btn_gap;
  );

  // VEL curve button — color-coded per mode, left-click cycles, right-click menu, scroll
  // Colors: LIN=green, SOFT=yellow, HARD=orange, FIX=red
  vel_curve == 0 ? gfx_set(0.30, 0.65, 0.35, 1) :  // green
  vel_curve == 1 ? gfx_set(0.78, 0.72, 0.30, 1) :  // yellow
  vel_curve == 2 ? gfx_set(0.82, 0.50, 0.22, 1) :  // orange
                   gfx_set(btn_red_r, btn_red_g, btn_red_b, 0.9);  // red
  gfx_rect(_btn1_x, _btn3_y, _btn_w, _btn_h);
  gfx_set(pad_well_r, pad_well_g, pad_well_b, 1);
  gfx_rect(_btn1_x, _btn3_y, _btn_corner, 1); gfx_rect(_btn1_x, _btn3_y, 1, _btn_corner);
  gfx_rect(_btn1_x + _btn_w - _btn_corner, _btn3_y, _btn_corner, 1); gfx_rect(_btn1_x + _btn_w - 1, _btn3_y, 1, _btn_corner);
  gfx_rect(_btn1_x, _btn3_y + _btn_h - 1, _btn_corner, 1); gfx_rect(_btn1_x, _btn3_y + _btn_h - _btn_corner, 1, _btn_corner);
